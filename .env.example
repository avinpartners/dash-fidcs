# Dash FIDCs settings. Iniciar.cmd writes .env by itself the first time; copy a line here to .env to change it.
# APP_HOST=127.0.0.1          # 0.0.0.0 after IT opens port 8081 for teammates
# APP_PORT=8081
# APP_PASSCODE=               # shared passcode to open the dashboard (empty = none)
# FIDC_HISTORY_MONTHS=24      # months of the informe mensal kept
# FIDC_REFRESH_MONTHS=3       # newest months checked again every day
# BACKUP_KEEP=14
